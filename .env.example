# Financial Analytics Platform — configuration template.
# Copy to .env and fill ONLY DB_USER and DB_PASSWORD. All other values have working defaults.

# --- MySQL / storage ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_app
DB_USER=
DB_PASSWORD=

# --- Data directories ---
FTE_UPLOAD_DIR=data/uploads
FTE_PROCESSED_DIR=data/processed
FTE_REJECTED_DIR=data/rejected

# --- Presentation URLs (hyperlink navigation) ---
# For LAN access from another machine, set these to this machine's LAN IP,
# e.g. http://192.168.21.161:5000 and http://192.168.21.161:8501
FTE_MAIN_URL=http://127.0.0.1:5000
FTE_STREAMLIT_URL=http://127.0.0.1:8501

# Bind address: 127.0.0.1 = this machine only, 0.0.0.0 = local network
FTE_BIND_HOST=0.0.0.0

# Bulk-load fast path for the loaders (load_staging / load_sampled /
# load_close_open_ratio).
#   1 = use LOAD DATA LOCAL INFILE for bulk batches when the MySQL server
#       allows it; ~1.3-1.6x faster on big loads. Requires the server setting
#       local_infile = ON (SET GLOBAL local_infile = 1;). If the server refuses
#       it, the loader prints one warning and falls back to the portable
#       row-wise upserts — results are identical either way.
#   0 = always use row-wise parameterized upserts (works on every server).
FTE_FAST_LOAD=0